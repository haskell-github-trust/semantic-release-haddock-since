{
  "name": "semantic-release-haddock-since",
  "version": "0.0.0-development",
  "description": "semantic-release plugin that stamps Haddock @since annotations on newly exported Haskell declarations",
  "keywords": [
    "haddock",
    "haskell",
    "semantic-release",
    "since"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haskell-github-trust/semantic-release-haddock-since.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc --noEmit -p tsconfig.test.json && tsc -p tsconfig.test.json --noEmit false --outDir dist-test && node --test dist-test/test/*.test.js",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "conventional-changelog-conventionalcommits": "^10.0.0",
    "semantic-release": "^24.2.0",
    "typescript": "^7.0.0"
  },
  "peerDependencies": {
    "semantic-release": ">=20"
  },
  "engines": {
    "node": ">=20"
  }
}
